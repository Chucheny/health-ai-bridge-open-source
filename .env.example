# Functions-scoped secret, production context only. Do not paste secrets in chat.
# Supabase: copy Transaction pooler URL; use a dedicated backend role.
HEALTH_DATABASE_URL=
# Optional trusted database CA (PEM) if the provider requires it. Never disable TLS validation.
HEALTH_DATABASE_CA=
# Disabled by default: set true only after DB schema, private credentials and HTTPS checks pass.
HEALTH_API_ENABLED=false
# Enable only after applying migrations 002 and 003 and verifying runtime grants.
HEALTH_TRAININGCAMP_ENABLED=false
# Independent ChatGPT read-only MCP gate; incomplete OAuth config must stay closed.
HEALTH_MCP_ENABLED=false
HEALTH_MCP_CONFIG=
