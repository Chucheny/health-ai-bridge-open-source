import {z} from 'zod';
import type {Database} from './database.mts';
import {ApiError, ns, typeSchema} from './protocol.mts';

const instant=z.iso.datetime({offset:true});
// Server receipts are generated by Date.toISOString(), at millisecond precision.
// Do not silently round finer input through PostgreSQL timestamptz (microseconds).
const receiptInstant=instant.refine(value=>{try{return ns(value)%1000000n===0n;}catch{return false;}});
const integer=z.string().regex(/^(0|[1-9][0-9]{0,18})$/);
const scopeSchema=z.strictObject({ownerId:z.uuid(),sourceId:z.uuid(),types:z.array(typeSchema).min(1).max(15),
  start:receiptInstant,end:receiptInstant});
const receiptSchema=z.strictObject({at:receiptInstant,operations:integer,committed:z.literal('true')});
const checkpointSchema=z.strictObject({type:typeSchema,sequence:integer,
  at:z.union([z.date(),instant]).nullable(),matches:integer,confirmed:z.boolean()});
export const MAX_OBSERVED_RECEIPTS=4000;
export type SyncObservationScope=z.infer<typeof scopeSchema>;

/** Operator-only read: submission metadata, never health rows, credentials or phone state. */
export async function inspectSyncObservation(database:Database,input:unknown,now:()=>Date=()=>new Date()) {
  const parsed=scopeSchema.safeParse(input);
  if(!parsed.success)throw new ApiError(400,'invalid_observation_input');
  const q=parsed.data,start=ns(q.start),end=ns(q.end);
  if(start>=end || end-start>31n*86400n*1000000000n || new Set(q.types).size!==q.types.length)
    throw new ApiError(400,'invalid_observation_input');
  let observedAt:string;
  try {observedAt=Date.prototype.toISOString.call(now());}
  catch {throw new ApiError(400,'invalid_observation_clock');}
  return database.transaction(async sql=>{
    await sql.query('SET TRANSACTION ISOLATION LEVEL REPEATABLE READ, READ ONLY');
    await sql.query("SET LOCAL statement_timeout='5s'");
    await sql.query("SET LOCAL lock_timeout='2s'");
    const state=(await sql.query('SHOW transaction_read_only')).rows;
    if(state.length!==1||state[0].transaction_read_only!=='on')throw new ApiError(503,'observation_not_read_only');
    const receiptRows=(await sql.query(`SELECT receipt->>'committedAt' AS at,
      receipt->>'operationCount' AS operations,receipt->>'committed' AS committed
      FROM health_bridge.sync_batches WHERE owner_id=$1 AND source_id=$2
      AND (receipt->>'committedAt')::timestamptz >= $3::timestamptz
      AND (receipt->>'committedAt')::timestamptz < $4::timestamptz
      ORDER BY (receipt->>'committedAt')::timestamptz,batch_id LIMIT $5`,
    [q.ownerId,q.sourceId,q.start,q.end,MAX_OBSERVED_RECEIPTS+1])).rows;
    const checkpointRows=(await sql.query(`SELECT s.record_type AS type,s.sequence::text AS sequence,
      s.committed_at AS at,count(b.batch_id)::text AS matches,
      coalesce(bool_and(b.receipt->>'committed'='true'),false) AS confirmed
      FROM health_bridge.sync_streams s LEFT JOIN health_bridge.sync_batches b
        ON b.owner_id=s.owner_id AND b.source_id=s.source_id
        AND b.receipt->>'sequence'=s.sequence::text
        AND (b.receipt->>'committedAt')::timestamptz=s.committed_at
      WHERE s.owner_id=$1 AND s.source_id=$2 AND s.record_type=ANY($3::text[])
      GROUP BY s.record_type,s.sequence,s.committed_at ORDER BY s.record_type`,
    [q.ownerId,q.sourceId,q.types])).rows;
    const receipts=z.array(receiptSchema).max(MAX_OBSERVED_RECEIPTS+1).safeParse(receiptRows);
    const checkpoints=z.array(checkpointSchema).max(15).safeParse(checkpointRows);
    if(!receipts.success||!checkpoints.success)throw new ApiError(503,'invalid_sync_metadata');
    const complete=receipts.data.length<=MAX_OBSERVED_RECEIPTS;
    const rows=receipts.data.slice(0,MAX_OBSERVED_RECEIPTS);
    const groups:{firstConfirmation:string;lastConfirmation:string;receiptCount:number;emptyReceiptCount:number;operationCount:string}[]=[];
    const days=new Map<string,{date:string;receiptCount:number;emptyReceiptCount:number;operationCount:string}>();
    let previous:bigint|undefined,operations=0n,empty=0;
    for(const row of rows){
      const at=ns(row.at);
      if(at<start||at>=end||(previous!==undefined&&at<previous))throw new ApiError(503,'invalid_sync_metadata');
      const count=BigInt(row.operations);
      const date=new Date(Number(at/1000000n)+8*3600000).toISOString().slice(0,10);
      const daily=days.get(date)??{date,receiptCount:0,emptyReceiptCount:0,operationCount:'0'};
      daily.receiptCount++;daily.emptyReceiptCount+=count===0n?1:0;daily.operationCount=(BigInt(daily.operationCount)+count).toString();days.set(date,daily);
      if(previous===undefined||at-previous>5n*60n*1000000000n)
        groups.push({firstConfirmation:row.at,lastConfirmation:row.at,receiptCount:0,emptyReceiptCount:0,operationCount:'0'});
      const group=groups.at(-1)!;
      group.lastConfirmation=row.at;group.receiptCount++;group.emptyReceiptCount+=count===0n?1:0;
      group.operationCount=(BigInt(group.operationCount)+count).toString();
      operations+=count;empty+=count===0n?1:0;previous=at;
    }
    const seen=new Set<string>();
    const streams=checkpoints.data.map(row=>{
      if(!q.types.includes(row.type)||seen.has(row.type))throw new ApiError(503,'invalid_sync_metadata');
      seen.add(row.type);
      // Receipts contain no record_type. Multiple streams can legitimately have
      // equal sequence/time. A non-unique match is unknown, never a verified one.
      return {type:row.type,sequence:row.sequence,committedAt:row.at instanceof Date?row.at.toISOString():row.at,
        receiptEvidence:row.matches==='1'?(row.confirmed?'matched':'unconfirmed'):row.matches==='0'?'missing':'ambiguous'};
    });
    return {schemaVersion:1,observedAt,readOnly:true,receiptMetadataOnly:true,healthPayloadsRead:false,phoneStateChecked:false,
      requestedWindow:{start:q.start,end:q.end,endExclusive:true},complete,
      status:!complete?'receipt_limit_reached':rows.length?'receipts_observed':'no_receipts_in_window',
      resultScope:complete?'all_matching_receipts':'earliest_receipts_only',
      observedReceiptCount:rows.length,emptyReceiptCount:empty,operationCount:operations.toString(),
      firstConfirmation:rows[0]?.at??null,lastObservedConfirmation:rows.at(-1)?.at??null,
      days:[...days.values()],confirmationGroups:groups,
      groupingPolicy:'Adjacent confirmations at most five minutes apart; heuristic groups are not identified sync runs.',
      checkpointScope:'Current configured installation and authorized types, independent of requested receipt dates; phone selection unknown.',
      streams,typesWithoutCheckpoint:q.types.filter(t=>!seen.has(t)),
      existingCheckpointEvidence:streams.length===0?'no_checkpoints':streams.every(s=>s.receiptEvidence==='matched')?'all_matched':'incomplete',
      backgroundPeriodicAcceptance:'not_verifiable_from_cloud_receipts',upstreamFreshness:'unknown',
      policy:'Operations are upserts/deletes, not new health-record counts. Empty batches can acknowledge checkpoints. Receipt time is server commit time. No receipts can mean no request or an earlier failure. Groups, gaps and current checkpoints do not prove foreground/background attribution, selected-type completeness, six-hour scheduling, overnight or reboot reliability.'};
  });
}
